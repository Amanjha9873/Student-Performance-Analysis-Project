import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Load Dataset
df = pd.read_csv("data/student_performance.csv")

print("STUDENT PERFORMANCE ANALYSIS")
print("=" * 40)

# 2. Display Dataset
print("\nFirst 5 Records:")
print(df.head())

print("\nDataset Information:")
print(df.info())

# 3. Check Missing Values
print("\nMissing Values:")
print(df.isnull().sum())

# 4. Data Cleaning
numeric_cols = df.select_dtypes(include=np.number).columns
df[numeric_cols] = df[numeric_cols].fillna(
    df[numeric_cols].median()
)

print("\nMissing Values After Cleaning:")
print(df.isnull().sum())

# 5. Statistical Analysis
print("\nStatistical Summary:")
print(df.describe())

# 6. Calculate Average Performance
print("\nAverage Final Score:",
      round(df["final_score"].mean(), 2))

print("Highest Score:",
      df["final_score"].max())

print("Lowest Score:",
      df["final_score"].min())

print("Average Attendance:",
      round(df["attendance_percent"].mean(), 2), "%")

print("Average Study Hours:",
      round(df["study_hours_per_day"].mean(), 2))

# 7. Performance Categories
df["performance_category"] = pd.cut(
    df["final_score"],
    bins=[-1, 39, 59, 79, 100],
    labels=[
        "Needs Improvement",
        "Average",
        "Good",
        "Excellent"
    ]
)

print("\nPerformance Categories:")
print(df["performance_category"].value_counts())

# 8. Visualization Settings
sns.set_theme(style="whitegrid")

# Graph 1: Score Distribution
plt.figure(figsize=(8, 5))
sns.histplot(df["final_score"], bins=15, kde=True)
plt.title("Student Final Score Distribution")
plt.xlabel("Final Score")
plt.ylabel("Number of Students")
plt.tight_layout()
plt.show()

# Graph 2: Study Hours vs Final Score
plt.figure(figsize=(8, 5))
sns.scatterplot(
    data=df,
    x="study_hours_per_day",
    y="final_score"
)
plt.title("Study Hours vs Final Score")
plt.xlabel("Study Hours Per Day")
plt.ylabel("Final Score")
plt.tight_layout()
plt.show()

# Graph 3: Attendance vs Final Score
plt.figure(figsize=(8, 5))
sns.scatterplot(
    data=df,
    x="attendance_percent",
    y="final_score"
)
plt.title("Attendance vs Final Score")
plt.xlabel("Attendance Percentage")
plt.ylabel("Final Score")
plt.tight_layout()
plt.show()

# Graph 4: Correlation Heatmap
plt.figure(figsize=(8, 6))
sns.heatmap(
    df.select_dtypes(include=np.number).corr(),
    annot=True,
    cmap="coolwarm",
    fmt=".2f"
)
plt.title("Correlation Heatmap")
plt.tight_layout()
plt.show()

# Graph 5: Performance Categories
plt.figure(figsize=(8, 5))
sns.countplot(
    data=df,
    x="performance_category",
    order=[
        "Needs Improvement",
        "Average",
        "Good",
        "Excellent"
    ]
)
plt.title("Student Performance Categories")
plt.xlabel("Performance Category")
plt.ylabel("Number of Students")
plt.xticks(rotation=15)
plt.tight_layout()
plt.show()

# 9. Correlation Analysis
print("\nCorrelation with Final Score:")
print(
    df.select_dtypes(include=np.number)
    .corr()["final_score"]
    .sort_values(ascending=False)
)

# 10. Save Cleaned Dataset
df.to_csv("cleaned_student_performance.csv", index=False)

print("\nProject Completed Successfully!")
print("Cleaned dataset saved successfully.")
